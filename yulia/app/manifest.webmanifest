{
  "id": "/yulia/app/",
  "name": "Yulia Fit — программа тренировок",
  "short_name": "Yulia Fit",
  "description": "Авторская программа тренировок Юлии: упражнения с анимацией техники, таймер отдыха и прогресс. Работает без интернета.",
  "lang": "ru",
  "dir": "auto",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0d0c0b",
  "theme_color": "#0d0c0b",
  "categories": ["health", "fitness", "sports", "lifestyle"],
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"},
    {"src": "icons/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any"}
  ],
  "shortcuts": [
    {"name": "Программы", "short_name": "Программы", "url": "./#/programs", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192"}]},
    {"name": "Упражнения", "short_name": "Упражнения", "url": "./#/lib", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192"}]},
    {"name": "Связь с Юлией", "short_name": "Связь", "url": "./#/contact", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192"}]}
  ],
  "screenshots": [
    {"src": "icons/shot-wide.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Yulia Fit"},
    {"src": "icons/shot-narrow.png", "sizes": "540x960", "type": "image/png", "form_factor": "narrow", "label": "Yulia Fit"}
  ]
